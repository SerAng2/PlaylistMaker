<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation_graph"
    app:startDestination="@id/mediaLibraryFragment">

    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.example.playlistMaker.mediaLibrary.presentation.ui.MediaLibraryFragment"
        android:label="MediaLibraryFragment"
        tools:layout="@layout/fragment_media_library">
        <action
            android:id="@+id/action_mediaLibraryFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_playlistsFragment"
            app:destination="@id/playlistsFragment"
            />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_playlistTrackFragment"
            app:destination="@id/playlistTrackFragment"
            app:popUpTo="@id/mediaLibraryFragment" >
        <argument
            android:name="playlistId"
            app:argType="long"
            app:nullable="false" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.playlistMaker.setting.presentation.ui.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.playlistMaker.search.presentation.ui.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/actionSearchToPlayer"
            app:destination="@id/playerFragment"
            app:popUpTo="@id/searchFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.playlistMaker.player.presentation.ui.PlayerFragment"
        android:label="PlayerFragment"
        tools:layout="@layout/fragment_player">

        <argument
            android:name="track"
            android:defaultValue="@null"
            app:argType="com.example.playlistMaker.common.domain.model.Track"
            app:nullable="true" />
        <action
            android:id="@+id/action_playerFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
        <action
            android:id="@+id/action_playerFragment_to_playlistsFragment"
            app:destination="@id/playlistsFragment" />
    </fragment>

    <activity
        android:id="@+id/rootActivity"
        android:name="com.example.playlistMaker.common.presentation.ui.RootActivity"
        android:label="RootActivity"
        tools:layout="@layout/activity_root" />
    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.example.playlistMaker.mediaLibrary.presentation.ui.NewPlaylistFragment"
        android:label="fragment_new_playlist2"
        tools:layout="@layout/fragment_new_playlist" >
    <argument
        android:name="playlistId"
        app:argType="long"
        android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/playlistsFragment"
        android:name="com.example.playlistMaker.mediaLibrary.presentation.ui.PlaylistsFragment"
        android:label="PlaylistsFragment"
        tools:layout="@layout/fragment_playlist">
    </fragment>

    <fragment
        android:id="@+id/playlistTrackFragment"
        android:name="com.example.playlistMaker.mediaLibrary.presentation.ui.PlaylistTrackFragment"
        android:label="PlaylistTrackFragment"
        tools:layout="@layout/fragment_playlist_track">
        <action
            android:id="@+id/action_playlistTrackFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
        <action
            android:id="@+id/action_playlistTrackFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
    </fragment>
</navigation>